# ─── Required ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ─── Storage (choose one adapter) ────────────────────────────────────────────
STORAGE_ADAPTER=postgres                              # postgres | mysql | cosmos | dynamo

# PostgreSQL / MySQL
DATABASE_URL=postgresql://arie:arie@localhost:5432/arie

# Azure Cosmos DB (if STORAGE_ADAPTER=cosmos)
# COSMOS_ENDPOINT=https://xxxx.documents.azure.com
# COSMOS_KEY=xxxxxxxxxxxx
# COSMOS_DATABASE=arie

# AWS DynamoDB (if STORAGE_ADAPTER=dynamo)
# AWS_REGION=us-east-1
# DYNAMO_TABLE_PREFIX=arie_

# ─── Agent Configuration ─────────────────────────────────────────────────────
WEEKLY_CRON_SCHEDULE=0 2 * * 0
CHANGE_DETECTION_INTERVAL_HOURS=6

# ─── Security ────────────────────────────────────────────────────────────────
API_KEY_SALT=change-this-to-a-random-64-char-string
