{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "_comment": "Power Automate Flow — Weekly Regulatory Digest",
  "_instructions": [
    "Import this flow in Power Automate:",
    "1. Power Automate → My flows → Import → Import Package",
    "2. Upload this file",
    "3. Configure connections: ARIE Custom Connector + Office 365 Outlook",
    "4. Set environment variables: ARIE_API_KEY, DIGEST_RECIPIENT_EMAIL"
  ],
  "flows": [
    {
      "name": "ARIE Weekly Regulatory Digest",
      "description": "Every Monday at 08:00, fetch regulation changes from ARIE and send a digest email",
      "trigger": {
        "type": "Recurrence",
        "recurrence": {
          "frequency": "Week",
          "interval": 1,
          "schedule": {
            "weekDays": ["Monday"],
            "hours": ["8"],
            "minutes": ["0"]
          },
          "timeZone": "GMT Standard Time"
        }
      },
      "actions": {
        "Get_Changed_Regulations": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "ARIE_Connection", "operationId": "ListRegulations" },
            "parameters": {
              "changedSince": "@{addDays(utcNow(), -7)}",
              "limit": 50
            }
          }
        },
        "Get_Agent_Runs": {
          "type": "OpenApiConnection",
          "inputs": {
            "host": { "connectionName": "ARIE_Connection", "operationId": "ListAgentRuns" }
          },
          "runAfter": { "Get_Changed_Regulations": ["Succeeded"] }
        },
        "Condition_Changes_Exist": {
          "type": "If",
          "expression": {
            "greater": ["@length(body('Get_Changed_Regulations')?['regulations'])", 0]
          },
          "runAfter": { "Get_Agent_Runs": ["Succeeded"] },
          "actions": {
            "Build_Regulation_Table": {
              "type": "Select",
              "inputs": {
                "from": "@body('Get_Changed_Regulations')?['regulations']",
                "select": {
                  "Jurisdiction": "@item()?['jurisdictionCode']",
                  "Title":        "@item()?['title']",
                  "Sector":       "@item()?['sector']",
                  "Summary":      "@item()?['summary']",
                  "Updated":      "@item()?['updatedAt']"
                }
              }
            },
            "Send_Digest_Email": {
              "type": "OpenApiConnection",
              "inputs": {
                "host": { "connectionName": "Office365", "operationId": "SendEmailV2" },
                "parameters": {
                  "emailMessage/To": "@parameters('DIGEST_RECIPIENT_EMAIL')",
                  "emailMessage/Subject": "ARIE Regulatory Digest — @{formatDateTime(utcNow(), 'dd MMM yyyy')} (@{length(body('Get_Changed_Regulations')?['regulations'])} changes)",
                  "emailMessage/Body": "<h2 style='color:#00C896;font-family:sans-serif'>ARIE Regulatory Intelligence</h2><h3>Weekly Digest — @{formatDateTime(utcNow(), 'dd MMM yyyy')}</h3><p><strong>@{length(body('Get_Changed_Regulations')?['regulations'])}</strong> regulation changes detected this week.</p><hr/><h4>Changed Regulations</h4><table border='1' cellpadding='8' style='border-collapse:collapse;font-family:sans-serif;font-size:14px'><tr style='background:#0F1929;color:white'><th>Jurisdiction</th><th>Title</th><th>Sector</th><th>Summary</th></tr>@{join(select(body('Get_Changed_Regulations')?['regulations'], item, concat('<tr><td><strong>', item?['jurisdictionCode'], '</strong></td><td>', item?['title'], '</td><td>', item?['sector'], '</td><td>', item?['summary'], '</td></tr>')), '')}</table><hr/><p style='color:gray;font-size:12px'>Generated by ARIE — Agentic Regulatory Intelligence Engine</p>",
                  "emailMessage/IsHtml": true
                }
              },
              "runAfter": { "Build_Regulation_Table": ["Succeeded"] }
            }
          }
        }
      }
    }
  ]
}
